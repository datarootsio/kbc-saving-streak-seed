# Build output
backend/target/
frontend/node_modules/
frontend/dist/

# The SQLite database is local state, recreated on first start
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Run logs from scripts/implement-tickets.sh and the /implement-tickets skill. Regenerated
# every run, and leaving them untracked would trip the clean-working-tree gate next run.
.scratch/*/logs/

# One git worktree per ticket, made and removed by the /implement-tickets skill.
.worktrees/
