# Build output
backend/target/
frontend/node_modules/
frontend/dist/

# Python bytecode from scripts/module-depth-map.py and its tests. Regenerated on every
# run and machine-specific (a .pyc records the source's mtime and its absolute path), so
# leaving it tracked would trip the clean-working-tree gate the moment anyone runs the tool.
__pycache__/
*.pyc

# The SQLite database is local state, recreated on first start
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Run logs from scripts/implement-tickets.sh and the /implement-tickets skill. Regenerated
# every run, and leaving them untracked would trip the clean-working-tree gate next run.
.scratch/*/logs/

# Console logs written by the Playwright CLI when an agent drives the page. Same reason as
# the run logs above: left untracked, they trip the clean-working-tree gate.
.playwright-cli/

# Maven output from a run made at the repository root rather than in backend/. Left
# untracked it trips the clean-working-tree gate that every ticket branch switch needs.
/target/

# macOS Finder metadata. Machine-local and recreated whenever Finder looks at a directory;
# left untracked it trips the clean-working-tree gate that every ticket branch switch needs.
.DS_Store
