# Template. `make install` substitutes the @PLACEHOLDERS@ and writes the result to
# @ENV_FILE@, which the systemd unit reads. Edit the template, then `make install`,
# so the deployed file is never the only copy of a decision.

# The demo profile: it seeds the customers a trainer demonstrates against, exposes the
# movable clock and the run-a-job-now endpoints, and is what the app is for.
SPRING_PROFILES_ACTIVE=dev

# Not 8080: code-server already listens there on this VM.
SERVER_PORT=@BACKEND_PORT@

# Loopback only. The backend is reached through nginx and nowhere else, so the port
# does not need to exist on the network interface at all.
SERVER_ADDRESS=127.0.0.1

# Absolute, because a relative path would follow the service's working directory and
# quietly create a second, empty database the first time that changed.
SAVING_STREAK_DB=@APP_DIR@/data/saving-streak.db

# One package at DEBUG, so a reviewer can read what the app actually did.
LOGGING_LEVEL_IO_DATAROOTS_SAVINGSTREAK=DEBUG
