# Template. `make install` substitutes the @PLACEHOLDERS@ and writes the result to
# /etc/nginx/sites-available/saving-streak, linked from sites-enabled.
#
# One origin for the whole app: nginx serves the built frontend and forwards /api to the
# backend on loopback. That is the same shape as the Vite dev proxy, so the frontend's
# relative /api calls work unchanged and there is no CORS to configure.
server {
    listen      @HTTP_PORT@ default_server;
    listen      [::]:@HTTP_PORT@ default_server;
    server_name _;

    # A copy under /var/www, not the build directory itself: nginx workers run as
    # www-data and cannot traverse @APP_DIR@, whose home directory is mode 750.
    root  @WEB_ROOT@;
    index index.html;

    access_log /var/log/nginx/saving-streak.access.log;
    error_log  /var/log/nginx/saving-streak.error.log;

    # Relative Location headers. nginx builds an absolute redirect from its own name and port,
    # which is wrong for every client that arrives through a proxy: a browser on
    # host:8080/absproxy/80 would be sent to host/absproxy/80/ and lose the port.
    absolute_redirect off;

    # Deposits and claims are small JSON bodies; anything larger is a mistake.
    client_max_body_size 1m;

    # code-server offers two proxy forms. /proxy/<port>/ strips its prefix before forwarding, so
    # what arrives here is already the plain path. /absproxy/<port>/ does not, and its requests
    # would fall through to the SPA fallback below and answer index.html to a request for the
    # bundle — which a browser rejects on MIME type, leaving a blank page. Stripping it here with
    # `last` re-runs location matching on the plain path, so both forms land on the rules below
    # and neither has to be the blessed one.
    location ~ ^/absproxy/[0-9]+(/.*)$ {
        rewrite ^/absproxy/[0-9]+(/.*)$ $1 last;
    }
    location ~ ^/absproxy/[0-9]+$ {
        return 301 $uri/;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:@BACKEND_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # An RFC 9457 problem document is the app's way of refusing, and its body carries
        # the reason the frontend shows. Passing it through unchanged keeps refusals readable.
        proxy_intercept_errors off;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # Vite fingerprints these filenames, so a stale copy can never be the wrong content.
    location /assets/ {
        try_files $uri =404;
        # add_header alone, not `expires`: the two together emit two Cache-Control headers.
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # One HTML page and no router, so anything that is not a file on disk is that page.
    location / {
        try_files $uri /index.html;
    }

    # The shell must not be cached, or a deploy leaves browsers asking for asset
    # filenames that no longer exist.
    location = /index.html {
        add_header Cache-Control "no-store";
    }
}
