# Template. `make install` substitutes the @PLACEHOLDERS@ and writes the result to
# /etc/systemd/system/saving-streak.service, so the unit carries this machine's paths
# instead of paths someone typed once and never checked again.
[Unit]
Description=Saving Streak backend (Spring Boot)
Documentation=file://@APP_DIR@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@RUN_USER@
Group=@RUN_USER@
WorkingDirectory=@APP_DIR@/backend
EnvironmentFile=@ENV_FILE@
ExecStart=@JAVA@ -jar @JAR@
Restart=on-failure
RestartSec=5

# Spring Boot exits 143 when systemd stops it with SIGTERM. Without this, every ordinary
# `make stop` would leave the unit in the failed state.
SuccessExitStatus=143
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=saving-streak

[Install]
WantedBy=multi-user.target
