server {
    listen @HTTP_PORT@;
    listen [::]:@HTTP_PORT@;
    server_name _;
    absolute_redirect off;
    client_max_body_size 50m;

    location ~ ^/absproxy/[0-9]+(/.*)$ {
        rewrite ^/absproxy/[0-9]+(/.*)$ $1 last;
    }
    location ~ ^/absproxy/[0-9]+$ {
        return 301 $uri/;
    }
    location / {
        proxy_pass http://127.0.0.1:@BACKEND_PORT@;
        proxy_http_version 1.1;
        # OpenRefine validates Host. nginx connects on loopback and supplies that
        # host, so every VM works without disabling validation or hardcoding DNS.
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A few OpenRefine resources use root-relative paths. Keep them inside
        # code-server's /proxy/<port>/ route without modifying the exercise code.
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter_types application/javascript text/javascript;
        sub_filter '"/command/' '"command/';
        sub_filter 'href="/' 'href="';
        sub_filter 'src="/' 'src="';
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_intercept_errors off;
    }
}
