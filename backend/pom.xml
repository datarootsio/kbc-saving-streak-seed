<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.dataroots</groupId>
    <artifactId>saving-streak</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>saving-streak</name>
    <description>Saving Streak — deposit money into savings, earn points</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- SQLite has no Hibernate-supported dialect; this community one is the price of
             the no-server, single-file, no-Docker constraint the lab needs. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Running the app locally means demonstrating it, and a demo needs seed data.
                         dev seeds the two households; demo adds the half of Anke that has already
                         been lived in - deposits in weeks that have ended, a run of secured weeks, a
                         mark she has fallen below, two dated goals and a standing rule - which is
                         what makes the simulator worth opening in the first minute. It is a second
                         profile rather than more of the first because the test suite counts a
                         hundred first weeks from a seeded Anke with no history at all; see
                         AHouseholdWithADecisionToMake. -->
                    <profiles>
                        <profile>dev</profile>
                        <profile>demo</profile>
                    </profiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
